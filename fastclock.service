[Unit]
Description=JMRI Fast Clock MQTT Service
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=dave
Group=dave
WorkingDirectory=/home/dave/FastClock
ExecStart=/home/dave/FastClock/.venv/bin/python /home/dave/FastClock/fastclock.py
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fastclock

[Install]
WantedBy=multi-user.target
